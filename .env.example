# .env.example — copy to .env and fill in your values. Never commit .env.

# Environment mode: "prod" | "test" | "test_file"
APP_ENV=test_file

# Provider — openrouter | openai
RULESBANK_PROVIDER=openrouter

# OpenAI (used when RULESBANK_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# OpenRouter (used when RULESBANK_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional — OpenRouter attributes usage to an app when these are sent
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=openapi-rulesbank

# LLM — the model name follows RULESBANK_PROVIDER by default
# (openrouter -> "openai/gpt-5.6-luna", openai -> "gpt-5.6-luna").
# Uncomment only to run a different model than the provider's default.
# RULESBANK_MODEL=
RULESBANK_TEMPERATURE=0
# none turns reasoning off; low | medium | high enable it
RULESBANK_REASONING_EFFORT=none

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Qdrant vector store (default: local instance)
QDRANT_HOST=localhost
QDRANT_PORT=6333
